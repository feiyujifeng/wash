-- mv.wash - 移动/重命名文件
-- 用法: mv <src> <dst>
local args = ...

if #args < 2 then
    wash.print("用法: mv <源文件> <目标路径>")
    return
end

local src = args[1]
local dst = args[2]

if wash.is_dir(dst) then
    local name = src:match("[^\\/]+$") or src
    dst = dst .. "\\" .. name
end

local ok = wash.move_file(src, dst)
if ok then
    wash.print("已移动: " .. src .. " -> " .. dst)
else
    wash.print("mv: 移动失败: " .. src)
end
