-- touch.wash - 创建空文件或更新时间戳
-- 用法: touch <filename>
local args = ...

if #args < 1 then
    wash.print("用法: touch <文件名>")
    return
end

for i = 1, #args do
    local path = args[i]
    if not wash.file_exists(path) then
        wash.write_file(path, "")
        wash.print("已创建: " .. path)
    else
        -- 文件已存在，用 os 原生接口更新时间戳（不受限模式）
        if os and os.execute then
            os.execute('copy /b "' .. path .. '" +,, >nul 2>&1')
        end
        wash.print("已更新: " .. path)
    end
end
